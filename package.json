{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "dev": "pnpm --parallel --filter @workspace/api-server --filter @workspace/vidsnap run dev",
    "build": "pnpm run typecheck && pnpm run build:app",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck",
    "build:app": "pnpm --filter @workspace/vidsnap build && pnpm --filter @workspace/api-server build",
    "start": "pnpm --filter @workspace/api-server start",
    "test": "node --test artifacts/api-server/test/*.test.mjs"
  },
  "private": true,
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=24"
  }
}
